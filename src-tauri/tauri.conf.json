{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism Music Player",
  "version": "0.3.0",
  "identifier": "com.prism.musicplayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Prism Music Player",
        "width": 1200,
        "height": 800,
        "label": "main",
        "devtools": true,
        "dragDropEnabled": false
      },
      {
        "title": "Prism - Lyrics",
        "label": "lyrics-popout",
        "url": "index.html?window=lyrics-popout",
        "width": 460,
        "height": 340,
        "minWidth": 280,
        "minHeight": 140,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
